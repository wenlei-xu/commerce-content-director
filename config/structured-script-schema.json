{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commerce short-video structured script",
  "type": "object",
  "required": ["schema_version", "script_id", "script_revision", "direction_id", "runtime", "strategy_snapshot", "hook", "beats", "dialogue", "screen_texts", "segments", "loops", "ending"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "script_id": {"type": "string", "pattern": "^SCRIPT-[A-Z0-9-]+$"},
    "script_revision": {"type": "integer", "minimum": 1},
    "direction_id": {"type": "string", "minLength": 1},
    "runtime": {
      "type": "object",
      "required": ["target_duration_seconds", "target_spoken_language", "audio_mode", "subtitle_mode"],
      "properties": {
        "target_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "target_spoken_language": {"type": "string", "enum": ["th", "zh-CN"]},
        "audio_mode": {"enum": ["spoken", "sparse_spoken", "natural_sound_only"]},
        "subtitle_mode": {"enum": ["auto_from_final_audio", "emphasis_from_final_audio", "none"]}
      }
    },
    "strategy_snapshot": {"type": "object", "required": ["target_audience", "viewer_before_state", "viewer_after_state", "content_format", "content_angle", "core_idea", "primary_cta"]},
    "hook": {"type": "object", "required": ["hook_id", "first_frame", "viewer_question", "promise", "payoff_beat_id"]},
    "beats": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["beat_id", "start", "end", "function", "visual_action", "product_state"]}},
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line_id", "beat_id", "segment_id", "start", "end", "text", "function", "delivery"],
        "properties": {
          "caption": {
            "type": "object",
            "properties": {
              "emphasis_spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["text", "style"],
                  "properties": {
                    "text": {"type": "string", "minLength": 1},
                    "style": {"enum": ["keyword_yellow", "number_pop", "result_pop", "product_accent", "pain_point_red"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "dialogue_quality_gate": {
      "type": "object",
      "required": ["instruction_manual_restatement_only", "pain_line_ids", "benefit_line_ids", "proof_line_ids", "natural_cta_line_ids"],
      "properties": {
        "instruction_manual_restatement_only": {"const": false},
        "pain_line_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "benefit_line_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "proof_line_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "natural_cta_line_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "screen_texts": {"type": "array", "items": {"type": "object", "required": ["text_id", "beat_id", "start", "end", "text", "function", "is_subtitle"]}},
    "product_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "beat_id": {"type": "string", "minLength": 1},
          "library_record_id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "how_to": {"type": "string", "minLength": 1},
          "visual_focus": {"type": "string", "minLength": 1},
          "action_reference_images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["file_token"],
              "properties": {
                "file_token": {"type": "string", "minLength": 1},
                "name": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1}
              }
            }
          },
          "related_benefit": {"type": "string", "minLength": 1}
        }
      }
    },
    "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["segment_id", "start", "end", "start_state", "end_state", "dialogue_ids", "product_final_state", "next_segment_inherits"]}},
    "loops": {"type": "array", "items": {"type": "object", "required": ["loop_id", "open_beat_id", "viewer_question", "close_beat_id", "payoff", "status"]}},
    "ending": {"type": "object", "required": ["primary_cta", "cta_screen_text_id", "ending_visual", "hook_closure"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {"audio_mode": {"enum": ["spoken", "sparse_spoken"]}},
            "required": ["audio_mode"]
          }
        }
      },
      "then": {"required": ["dialogue_quality_gate"]}
    }
  ]
}
